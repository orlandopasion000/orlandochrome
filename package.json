{
  "name": "chrome-taskbar-command-center",
  "version": "1.0.0",
  "description": "Live bidirectional tracking, cooldown waitboard and window switcher for 22+ pinned Chrome profiles on the Windows taskbar",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "package": "electron-packager . OrlandoChrome --platform=win32 --arch=x64 --icon=public/favicon.ico --out=dist --overwrite --prune=true"
  },
  "keywords": [
    "chrome",
    "profiles",
    "taskbar",
    "command-center",
    "waitboard",
    "cooldown",
    "rate-limits"
  ],
  "author": "Orlando V. Pasion, Jr.",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-packager": "^17.1.2"
  }
}
